<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Grntly Brewer managed Homebrew upgrade.
  Install to /Library/LaunchDaemons/com.grntly.upgrade.plist (root:wheel, 644),
  place managed-upgrade.sh at /usr/local/grntly/managed-upgrade.sh, then:
    sudo launchctl bootstrap system /Library/LaunchDaemons/com.grntly.upgrade.plist
  Runs weekly on Monday at 09:00.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.grntly.upgrade</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/usr/local/grntly/managed-upgrade.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/grntly-upgrade.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/grntly-upgrade.log</string>
</dict>
</plist>
